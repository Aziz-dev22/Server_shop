# توکن ربات که از @BotFather گرفته‌اید
BOT_TOKEN=

# شناسه عددی تلگرام ادمین/ادمین‌ها (با کاما جدا شود اگر چند نفر هستند)
# برای گرفتن شناسه عددی خودتان به ربات @userinfobot پیام دهید
ADMIN_IDS=

# مسیر فایل دیتابیس (نیازی به تغییر نیست)
DB_PATH=shop.db

# نام کاربری و رمز عبور ورود به پنل مدیریت تحت وب
# آدرس پنل بعد از نصب: http://IP-SERVER:8088
PANEL_USERNAME=admin
PANEL_PASSWORD=

# نکته: API هتزنر، آدرس واریز دستی و درگاه ارز دیجیتال (OxaPay)
# همگی از داخل خود ربات با دستور /admin یا از داخل پنل تحت وب تنظیم می‌شوند و نیازی
# به ویرایش این فایل برای آن‌ها نیست.
